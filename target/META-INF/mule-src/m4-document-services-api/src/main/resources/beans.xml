<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:context="http://www.springframework.org/schema/context"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:jdbc="http://www.springframework.org/schema/jdbc"

    xsi:schemaLocation="http://www.mulesoft.org/schema/mule/jdbc http://www.mulesoft.org/schema/mule/jdbc/current/mule-jdbc.xsd http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-4.1.xsd
        http://www.springframework.org/schema/jdbc
        http://www.springframework.org/schema/jdbc/spring-jdbc-4.1.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context-4.1.xsd">

		<!-- replace db name with appropriate db name and provide meaningful pool name -->
		
        <bean id="DataSource-loggerDB" name="loggerDB-Bean" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
            <property name="dataSourceClassName" value="com.microsoft.sqlserver.jdbc.SQLServerDataSource"/>
            <property name="poolName" value="loggerDBConnectionPool"/>
            <property name="maximumPoolSize" value="${db.integration.azure.mssql.pool.size.max}"/>
            <property name="connectionTimeout" value="${db.integration.azure.mssql.pool.connection.timeout}"/>
            <property name="maxLifetime" value="${db.integration.azure.mssql.pool.maxLifetime}"/>
            <property name="dataSourceProperties">
                <props>
                    <prop key="serverName">${db.integration.logger.mssql.host}</prop>
                    <prop key="portNumber">${db.integration.logger.mssql.port}</prop>
                    <prop key="databaseName">${db.integration.logger.mssql.database}</prop>
                    <prop key="trustServerCertificate">${db.integration.logger.mssql.trustServerCertificate}</prop>
                    <prop key="user">${db.integration.logger.mssql.user}</prop>
                    <prop key="password">${db.integration.logger.mssql.password}</prop>
                </props>
            </property>
        </bean>

</beans>