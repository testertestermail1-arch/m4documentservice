						<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
vars.monfilePath]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="a9409f1a-b9f3-4acc-af79-c1099276df6e" >
