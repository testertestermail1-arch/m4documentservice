			</ee:variables>
		</ee:transform>
					</otherwise>
				</choice>
				
			</when>
			<otherwise >
				<set-variable value="#[vars.monfilePath]" doc:name="Set filePathVar Variable" doc:id="0e93800e-9293-401a-ae33-5bb9a6905a16" variableName="filePathVar"/>
