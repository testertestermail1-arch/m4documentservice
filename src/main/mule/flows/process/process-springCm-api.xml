				<flow-ref doc:name="system-springCm-api-create-monthly-folder-Flow" doc:id="4403701a-a5e6-47b1-8586-c4afcb86b30c" name="system-springCm-api-create-monthly-folder-Flow"/>
				<set-variable value="#[attributes.headers.'Content-Encoding']" doc:name="Set StatusVar" doc:id="9307ed4d-3ea5-4d92-b25f-0c6b5f2ebe13" variableName="encodingVar"/>
				<choice doc:name="is gzip Encoding ?" doc:id="a276a5eb-7bf5-4778-b1a1-3f2e7453e5e3" >
			<when expression="#[vars.encodingVar == 'gzip']">
