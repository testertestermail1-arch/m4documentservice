						<ee:set-attributes ><![CDATA[%dw 2.0
output application/java
---
{
	"MULE_ENCODING": "UTF-8"
}]]></ee:set-attributes>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="statusVar" ><![CDATA[%dw 2.0
output application/java
---
attributes.statusCode]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</when>
			<otherwise>
			<ee:transform doc:name="Setting Payload" doc:id="170cb4be-80b1-43ad-b3a4-5be5a380e833" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
						<ee:set-attributes ><![CDATA[%dw 2.0
output application/java
---
{
	"MULE_ENCODING": "UTF-8"
}]]></ee:set-attributes>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="statusVar" ><![CDATA[%dw 2.0
output application/java
---
attributes.statusCode]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</otherwise>
		</choice>
				<choice doc:name="Does Folder already exist?" doc:id="71d907a2-576d-4c28-99eb-b892045c92f9" >
					<when expression="#[vars.statusVar == 422]">
						<raise-error doc:name="Already Folder Exist Error" doc:id="979fa64d-9541-4cb3-8b58-5cb96d7f58bc" type="CUS_FOLDER:EXIST"/>
					</when>
					<otherwise >
						<set-variable value="#[payload.BrowseDocumentsUrl]" doc:name="Setting monFolderUrl Variable" doc:id="cf24db6c-3f80-445e-9977-3ab263bc8b3a" variableName="folderUrl" />
						<ee:transform doc:name="Setting monFolderUrl" doc:id="33794cca-e8ae-41ed-a852-d18feff8c262">
			<ee:message>
								<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
(vars.folderUrl splitBy "/")[7]]]></ee:set-payload>
			</ee:message>
			<ee:variables>
						<ee:set-variable variableName="springcmerror"><![CDATA[%dw 2.0
