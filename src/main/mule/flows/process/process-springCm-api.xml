				<ee:transform doc:name="Storing required variable" doc:id="6458f5c9-b48d-4aeb-82d5-ad3e1c0595d9" >
					<ee:message >
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="hostVar" ><![CDATA[%dw 2.0
output application/java
---
p('springcm.document.generation.api.implementation.host')]]></ee:set-variable>
						<ee:set-variable variableName="pathVar" ><![CDATA[%dw 2.0
output application/java
---
p('springcm.folder.upload.api.implementation.path')]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<set-variable value="#['https://' ++ vars.hostVar ++ vars.pathVar ++ '/' ++ vars.monfilePath]" doc:name="Set parentUpdatedVar Variable" doc:id="a9865179-a115-4468-8fbd-78f6b176d48e" variableName="parentUpdatedVar"/>
				<ee:transform doc:name="Create Forms Folder Payload" doc:id="d3000c1a-6f89-4dad-abd7-57307ca8498b" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
