	<sub-flow name="process-springCm-authetication-api-Flow" doc:id="0c4068ff-3d4c-4d14-abb1-51aaf01edf5f" >
		<logger level="INFO" doc:name=" Entered Into SpringCm Authentication Flow Logger" doc:id="e15cfb06-4a9d-4df7-a1e1-a9ae92d846cb" message="MessageId: #[correlationId] || Entered into springCm authentication flow"/>
		<ee:transform doc:name="Framing Form Api" doc:id="f9f373f0-3fef-4cc8-a48b-6b2f7645d857">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="formApiId"><![CDATA[%dw 2.0
output application/java
---
correlationId ++ ' || ' ++ vars.contractNumber]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<os:contains doc:name="Check Key Availability" doc:id="9d38630c-b4d7-4a05-9792-80f862cfa090" key="auth_token" objectStore="springCM_Auth_ObjectStore"/>
		<logger level="INFO" doc:name="Log Token Availability Logger" doc:id="7d668367-0498-4615-9710-d29e20d683d9" message="MessageId: #[correlationId] || After contains auth token value : #[payload] || formApiId: #[vars.formApiId]" />
		<choice doc:name="Is Auth_token Key Available?" doc:id="7c612c8f-362a-4b2d-a389-348ab4a34563" >
			<when expression="#[payload == true]">
				<logger level="INFO" doc:name="Key Available Logger" doc:id="66149e4c-428f-4ccf-bbbb-58120879b6c0" message="MessageId: #[correlationId] || Key Available . Retrieving from Object Store"/>
				<os:retrieve doc:name="Retrieve Token From Object Store" doc:id="21759cff-474e-4977-883f-5a83a6f55141" key="auth_token" objectStore="springCM_Auth_ObjectStore" target="authTokenVar"/>
				<ee:transform doc:name="tokenLifeTimeinms Variable" doc:id="59109f43-1cda-4923-a98a-5c34ba566f3a">
			<ee:message>
			</ee:message>
					<ee:variables >
						<ee:set-variable variableName="tokenLifeTimeinms" ><![CDATA[%dw 2.0
output application/java
var tokenLifeTimeinms = if(not isEmpty(vars.authTokenVar))((now() as String {"format":"yyyyMMddHHmmss"}) - vars.authTokenVar.current_timestamp) else 0
---
if(not isEmpty(vars.authTokenVar))(vars.authTokenVar.expires_in - tokenLifeTimeinms) else 0]]></ee:set-variable>
					</ee:variables>
		</ee:transform>
				<logger level="INFO" doc:name="Retrieved Token from Object Store Logger" doc:id="08e0049c-98e4-4651-bf71-ce5b48e1f39c" message="Retrieved Token from Object Store || tokenLifeTimeinms: #[vars.tokenLifeTimeinms]"/>
				<choice doc:name="Check TokenValidity &gt; 300 ms" doc:id="3d5a30cd-7c63-410a-8a50-bb359b30a994" >
					<when expression="#[(not isEmpty(vars.authTokenVar)) and (vars.tokenLifeTimeinms &gt; 600)]">
						<logger level="INFO" doc:name="After Retrieved Auth Token from Object Store Logger" doc:id="cfec7624-1c51-401f-a342-aee9f482c501" message="After Retrieved Auth Token from Object Store "/>
						<set-payload value="#[vars.authTokenVar]" doc:name="Set AuthToken Payload" doc:id="92aca932-35f4-48a6-b1ba-05735f0142fc" />
					</when>
					<otherwise >
				<flow-ref doc:name="Process SpringCm Authentication Flow" doc:id="ae508015-c10e-4728-b252-717f5bdf4568" name="process-springCm-authetication-call-Flow" target="authTokenVar"/>
						<set-payload value="#[vars.authTokenVar]" doc:name="Set AuthToken Payload" doc:id="70f1d1e8-89ce-4a75-8589-8547b4ad8c61" />
				
			</otherwise>
				</choice>
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Stage Logger" doc:id="998ab0ce-4b4a-4061-ac25-4fe1613667cd" message="MessageId: #[correlationId] || Key not Available in objectstore"/>
				<flow-ref doc:name="Process SpringCm Authentication Flow" doc:id="d8d903a5-f7e2-48af-9189-d45c3d9f987e" name="process-springCm-authetication-call-Flow" target="authTokenVar"/>
				<set-payload value="#[vars.authTokenVar]" doc:name="Set AuthToken Payload" doc:id="d8fe2f04-bf6d-4794-acbf-e1c89a616ff4" />
				
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="process-springCm-authetication-call-Flow" doc:id="14e50d5f-e431-40a6-a8ca-a6606cc848ef">
	<logger level="INFO" doc:name="Logger" doc:id="b878387c-3380-48ba-a877-afe573e6f8e1" message="value of #[p('document.authentication.source')]"/>
		<choice doc:name="Choice" doc:id="46af4070-bc88-4b79-91cd-4180de5d96f4" >
			<when expression="#[lower (p('document.authentication.source')) == 'docusign']">
				<logger level="INFO" doc:name="Logger" doc:id="5daaf194-f6d5-481e-a36a-d731bcb0ff85" message="Calling Docusign Authentication Flow"/>
				<flow-ref doc:name="System Docusign Authentication FLow" doc:id="ec951d72-ed3a-4d6a-84ba-8b35854e772d" name="system-docusign-Authentication-flow"/>
			</when>
			<otherwise >
				<flow-ref doc:name="System SpringCm Authentication Flow" doc:id="f6413e6a-a02e-40d0-85a2-84f07b43b1e4" name="system-springCm-authetication-Flow" />
			</otherwise>
		</choice>
				<ee:transform doc:name="Transform-payload to-Java Type" doc:id="d4a49d66-fce3-4e90-b27a-7ac6d3d3f279">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/java
---
{
	token_type: if(not isEmpty(payload) and not isEmpty(payload.token_type)) payload.token_type else '',
	access_token: if(not isEmpty(payload) and not isEmpty(payload.access_token)) payload.access_token else '',
	api_base_url: if(not isEmpty(payload) and not isEmpty(payload.api_base_url)) payload.api_base_url else '',
	expires_in: if(not isEmpty(payload)) payload.expires_in else 0,
	current_timestamp: now() as String {"format":"yyyyMMddHHmmss"},
	error: if(not isEmpty(payload) and not isEmpty(payload.errorDescription)) payload.errorDescription  else ''
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<os:store doc:name="Store Auth Token" doc:id="1e1c0e66-9327-45cf-9dd0-ac2cc93e4415" key="auth_token" objectStore="springCM_Auth_ObjectStore" />
	</sub-flow>
	<flow name="process-springCm-upload-document-separatefolderFlow" doc:id="e412d892-8b63-48fc-822d-b35d68ea44a4" >
		<ee:transform doc:name="Storing Required Variables" doc:id="1c3acac2-acef-4672-8452-68f58ec8668e" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="parentFolderURL" ><![CDATA[%dw 2.0
output application/java
---
if(isEmpty(vars.isEnterpriseAccount)) p('document.authentication.parent.folderId.url')
else p('document.authentication.parent.ent.folderId.url')]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<logger level="INFO" doc:name="Inside SpringCM Upload Document Flow" doc:id="1a3f7e82-4f94-4343-ac45-5834b0c6ed56" message="Message Id : #[correlationId] || Inside SpringCM Upload Document Flow"/>
		<flow-ref doc:name="process-springCm-authetication-api-Flow" doc:id="af9d7cb2-4ec5-46cf-bd33-6cbf99b9073e" name="process-springCm-authetication-api-Flow"/>
		<ee:transform doc:name="Framing Access Token" doc:id="4acdfa6c-11f9-47f3-bc10-01ec61a37f8c" >
