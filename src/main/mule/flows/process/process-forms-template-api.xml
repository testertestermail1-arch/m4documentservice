<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:scripting="http://www.mulesoft.org/schema/mule/scripting"
	xmlns:os="http://www.mulesoft.org/schema/mule/os" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/scripting http://www.mulesoft.org/schema/mule/scripting/current/mule-scripting.xsd http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">
	<sub-flow name="process-forms-template-api-flow" doc:id="29af8280-4a98-4270-9ead-c374d49952c6" >
		<set-variable value="#[attributes.uriParams.'template-id']" doc:name="Set templateId Variable" doc:id="05fd262a-b9c0-48a7-9a0b-e0f4bd9ba321" variableName="templateId"/>
		<salesforce:query doc:id="d96292cb-bf5a-4163-87f3-7fc2178428ed" doc:name="Retrieve Template From Glow" config-ref="salesforceConfig">
			<salesforce:salesforce-query ><![CDATA[Select Template_URL__c from Form_Master_Table__c where Name =':formNumber']]></salesforce:salesforce-query>
			<salesforce:parameters ><![CDATA[#[output application/java
---
{
	formNumber : vars.templateId
}]]]></salesforce:parameters>
		</salesforce:query>
		<choice doc:name="Is Template URL Found?" doc:id="1ff9d6e0-02b5-4c95-abe8-4b11ef8c4a2e" >
			<when expression="#[!isEmpty(payload)]">
				<ee:transform doc:name="Frame Template URL" doc:id="ec702f30-e93d-4c79-862d-fcae4b5d532e" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
fun queryParameters(url) = url splitBy "&"
---
queryParameters(payload[0].Template_URL__c) map (() -> if ( (upper($) startsWith  "LDUID=") or (upper($) startsWith "ID=") or (upper($) startsWith  "UID=") ) {
	templateId: (upper ($) replace "LDUID=" with "" replace  "ID=" with "" replace "UID=" with "")
}else null)]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<ee:transform doc:name="Set Template Variable" doc:id="082f8ece-18b3-41db-9ddc-7635f7d57559" >
					<ee:message >
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="contractNumber" ><![CDATA[%dw 2.0
output application/java
---
payload.templateId[0]]]></ee:set-variable>
						<ee:set-variable variableName="SpringCMTemplateID" ><![CDATA[%dw 2.0
output application/java
---
payload.templateId[0]]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
				<flow-ref doc:name="Call Process SpringCm Authentication Flow" doc:id="0d9486e4-854b-4099-9132-88b74c3bbdac" name="process-springCm-authetication-api-Flow"/>
				<ee:transform doc:name="Set-Document-Download-Host-and-Path" doc:id="0aff8e40-2454-4ca8-9ad5-c24d4c403713" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
	downloadDocumentHost: p('springcm.document.download.api.implementation.host'),
	downloadDocumentPath:(p('springcm.document.download.api.implementation.path') ++ '/' ++ vars.contractNumber),
	documentId: vars.contractNumber
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<flow-ref doc:name="system-springCM-download-template-flow" doc:id="ca07ba9f-d5e6-47f4-8cb2-1e021a7f518f" name="system-springCM-download-template-flow" />
				<ee:transform doc:name="Base 64 Decode PDF Response" doc:id="7e29ed64-ecd6-410d-bfbf-b1837055635b" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
import * from dw::core::Binaries
output application/java
---
fromBase64(payload.pdfResponse)

]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<set-payload value="#[payload]" doc:name="Set Payload for PDF Response" doc:id="030de277-551e-4ea7-bfd3-7c2bcfa41bd3" mimeType="application/pdf" />
			</when>
			<otherwise >
				<logger level="INFO" doc:name="Stage Logger" message="Stage 2 Error Template URL Empty || Form Number: #[vars.templateId]"/>
				<raise-error doc:name="Raise URL Empty Error" doc:id="3af89d47-df36-47a9-bd83-05c87b74532a" description="Template URL is null" type="VALIDATION"/>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
